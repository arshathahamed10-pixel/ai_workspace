pipeline {
    agent any

    tools {
        maven 'Maven'   // Name of Maven installation configured in Jenkins Global Tool Config
        jdk 'Jdk17'  
    }

    environment {
        GIT_REPO_URL = 'https://github.com/arshathahamed10-pixel/ai_workspace.git'
        GIT_BRANCH   = 'dev'
        APP_DIR      = 'spring-boot-app'
        DC_CHECK     = 'C:\\Program Files\\dependency-check'
        PATH = "C:\\Program Files\\grype_0.116.0_windows_amd64;${env.PATH}"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: "${GIT_BRANCH}",
                    url: "${GIT_REPO_URL}",
                    credentialsId: 'ARSHATH10'   // Jenkins credential ID for git access
            }
        }

         stage('Build') {
            steps {
                dir("${APP_DIR}") {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Verify Grype Installed') {
            steps {
                bat 'grype version'
            }
        }

          stage('Grype Vulnerability Scan') {
            steps {
                dir("${APP_DIR}") {
                    bat 'grype db update'
                    bat 'grype dir:. -o json --file grype-report.json'
                    bat 'grype dir:. -o table'
                }
            }
        }

         stage('OWASP Dependency-Check') {
            steps {
                dependencyCheck additionalArguments: '''
                    -o "./"
                    -s "./"
                    -f "ALL"
                    --prettyPrint
                ''', odcInstallation: 'CVC scanner'
            }
        }

        stage('Publish Report') {
            steps {
                dependencyCheckPublisher pattern: 'dependency-check-report.xml'
            }
        }
        
    }

    post {
        success {
            echo 'Build completed successfully!'
        }
        failure {
            echo 'Build failed!'
        }
    }
}
