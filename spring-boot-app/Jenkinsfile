pipeline {
    agent any

    tools {
        maven 'Maven'   // Name of Maven installation configured in Jenkins Global Tool Config
        jdk 'Jdk17'      // Name of JDK installation configured in Jenkins Global Tool Config
    }

    environment {
        GIT_REPO_URL = 'https://github.com/arshathahamed10-pixel/ai_workspace.git'
        GIT_BRANCH   = 'test'
        APP_DIR      = 'spring-boot-app'
        PATH = "C:\\Program Files\\grype_0.116.0_windows_amd64;${env.PATH}"
        TEMPLATE     = "C:\\Program Files\\template\\grype-html.tmpl"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: "${GIT_BRANCH}",
                    url: "${GIT_REPO_URL}",
                    credentialsId: 'ARSHATH10'   // Jenkins credential ID for git access
            }
        }

         stage('Build') {
            steps {
                dir("${APP_DIR}") {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

          stage('Grype Vulnerability Scan') {
            steps {
                dir("${APP_DIR}") {
                    bat 'grype db update'
                    bat "grype dir:. -o template -t \"${TEMPLATE}\" > grype-report.html"
                }
            }
        }

        stage('Publish Report') {
            steps {
                publishHTML(target: [
                    reportName: 'Grype Vulnerability Report',
                    reportDir: '.',
                    reportFiles: 'grype-report.html',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing: false
                ])
            }
        }
        
    }

    post {
        success {
            echo 'Build completed successfully!'
        }
        failure {
            echo 'Build failed!'
        }
    }
}
