pipeline {
    agent any

    tools {
        maven 'Maven'   // Name of Maven installation configured in Jenkins Global Tool Config
        jdk 'Jdk17'      // Name of JDK installation configured in Jenkins Global Tool Config
    }

    environment {
        GIT_REPO_URL = 'https://github.com/arshathahamed10-pixel/ai_workspace.git'
        GIT_BRANCH   = 'dev'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: "${GIT_BRANCH}",
                    url: "${GIT_REPO_URL}",
                    credentialsId: 'ARSHATH10'   // Jenkins credential ID for git access
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'Build completed successfully!'
        }
        failure {
            echo 'Build failed!'
        }
    }
}
